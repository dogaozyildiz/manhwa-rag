# Copy to .env and fill in.  .env is gitignored — never commit it.
#   cp .env.example .env

# Local Postgres from docker-compose. Not a secret: this container is bound to
# localhost and holds only public metadata. Do not reuse this pattern for
# anything that leaves your machine.
DATABASE_URL=postgresql+psycopg://manhwa:manhwa@localhost:5434/manhwa

# --- Generation --------------------------------------------------------------
# Leave everything here blank to run retrieval only: POST /retrieve,
# scripts.search and the retrieval tier of the eval all work with no key.
#
# groq   - free tier, available in the EU, fast. Default.
# gemini - free key at aistudio.google.com, but the free tier allocates ZERO
#          generation quota in the EEA (calls return `limit: 0`), so it is
#          unusable from Germany without enabling billing.
# ollama - fully local, no account, no network. See app/answer/ollama.py.
LLM_PROVIDER=groq

# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
ANSWER_MODEL=gemini-2.0-flash

# Local generation. No key needed; requires `ollama pull qwen2.5:7b`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Embeddings --------------------------------------------------------------
# Run locally via sentence-transformers. No key, no cost, no network at query
# time. Changing the model means changing EMBEDDING_DIM and the migration
# together — they must not drift.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Corpus size -------------------------------------------------------------
N_MANHWA=350
N_MANGA=150

# --- Retrieval tuning --------------------------------------------------------
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
TOP_K=5
CANDIDATE_K=20
